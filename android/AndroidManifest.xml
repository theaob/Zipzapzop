<?xml version="1.0" encoding="utf-8"?>
<!-- Gradle sets the package (namespace), SDK levels and version from build.gradle.
     build-apk.sh fills those in itself for the local, ad-free debug build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Daily challenge reminder (local only): post it, and re-arm it after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Ads and Play purchases. The AdMob and Billing libraries add AD_ID and BILLING themselves. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:appCategory="game"
        android:theme="@style/ZapTheme">
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- Play Games project ID: empty, and Play Games off, unless CI wrote games-ids.xml (see build.gradle). -->
        <meta-data android:name="com.google.android.gms.games.APP_ID" android:value="@string/zzz_games_app_id" />
        <!-- Analytics and crash reports start switched off; Telemetry turns them on once consent allows. -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <!-- No screenOrientation lock: phones, tablets and car screens all rotate freely, and the page lays itself
                 out for portrait or landscape (configChanges keeps the game running through a rotation). Android Auto: CAR_LAUNCHER plus appCategory="game" puts the game on the car screen,
                 parked only (Android 15+ phones). Never add distractionOptimized metadata: that is what keeps
                 Android Auto from showing the game while the car moves. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Shared Daily links open the game on that puzzle (LinkActivity hands it over and closes).
             The https link is an App Link: Android opens it straight in the app once it has checked
             https://theaob.github.io/.well-known/assetlinks.json (see android/README.md); until then it opens
             the link page in the browser, whose button uses the zipzapzop:// link below. -->
        <activity
            android:name=".LinkActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="theaob.github.io" android:pathPrefix="/Zipzapzop/daily" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zipzapzop" android:host="daily" />
            </intent-filter>
        </activity>
        <!-- Serves the shared result picture to the app the player picks; see ShareProvider. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true" />
        <receiver android:name=".ReminderReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
